<Window x:Class="ProductTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProductTest"
        mc:Ignorable="d"
        Title="Продукты" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image Source="/Resources/ico/Чудо Обувь.png" Height="50" Width="50" HorizontalAlignment="Left" />
            <TextBlock Text="Чудо обувь" VerticalAlignment="Center" Margin="10"/>
        </StackPanel>
        
        <ScrollViewer Grid.Row="1">
            <ItemsControl Name="ProductList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="10" BorderBrush="#D2F6E7"  BorderThickness="2" Background="{Binding Background}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="80" Height="80" Margin="10" BorderBrush="#D2F6E7" BorderThickness="2">
                                    <Image Source="{Binding PathImages}"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock HorizontalAlignment="Center">
                                        <Run Text="{Binding Production}"/>
                                        <Run Text=" | "/>
                                        <Run Text="{Binding Name}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Category}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding TotalStock}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding Structure}" TextWrapping="Wrap" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Grid.Column="2">
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N2} руб.}" HorizontalAlignment="Right" Margin="10"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
